# Copier ce fichier en .env (à la racine du dépôt, jamais commité) et remplir les valeurs.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_LOG_SQL=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL 18 (sans PostGIS)
DB_NAME=smartagri
DB_USER=smartagri
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Données brutes (lecture seule, hors du dépôt) — mettre le chemin de son propre poste
RAW_DATA_DIR=C:/chemin/vers/projet_dev

# Compte administrateur créé par : python manage.py creer_admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smartagri.tn
ADMIN_PASSWORD=
